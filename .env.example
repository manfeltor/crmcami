# Plantilla de configuración. Copiar a .env y completar.
# En Cloud Run estas variables se inyectan desde Secret Manager (no hay .env).
# Se leen con python-decouple (ver crmcami/crmcami/authvars.py).

# --- Django ---
SECRET_KEY=cambiame-por-uno-largo-y-aleatorio
DEBUG=True

# --- Base de datos (MySQL) ---
DB_NAME=crm
DB_USR=crm
DB_PASS=crm
# Local: TCP.  Prod (Cloud SQL): /cloudsql/PROYECTO:REGION:INSTANCIA  (Django usa socket)
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Host del servicio (Cloud Run) ---
# Alimenta ALLOWED_HOSTS y CSRF_TRUSTED_ORIGINS. Vacío en local.
APPHOST=

# --- WordPress (Formidable) — ingesta de leads ---
WPUSER=usuario-wp
WPPASS=application-password-de-wp
WPCUSTOMAPISUBM=https://intralog.com.ar/wp-json/custom/v1/form-submissions/

# --- Overrides opcionales (ensayo local con DEBUG=False) ---
# SECURE_SSL_REDIRECT=False
# CSRF_TRUSTED_ORIGINS=http://localhost:8080
